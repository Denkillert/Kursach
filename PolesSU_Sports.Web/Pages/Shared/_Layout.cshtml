<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#054226" />
    <title>@ViewData["Title"] - PolesSU Sports</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <div class="header-container">
            <div class="logo-section">
                <div class="logo">🎓</div>
                <div class="logo-text">
                    <h1>PolesSU Sports</h1>
                    <span>Система управления спортивными секциями</span>
                </div>
            </div>
            <nav class="main-nav">
                @if (Context.Session.GetString("UserRole") != null)
                {
                    @if (Context.Session.GetString("UserRole") == "Student")
                    {
                        <a href="/Student/Index">🏠 Главная</a>
                        <a href="/Student/Sections">⚽ Секции</a>
                        <a href="/Student/Schedule">📅 Расписание</a>
                    }
                    @if (Context.Session.GetString("UserRole") == "Trainer")
                    {
                        <a href="/Trainer/Index">🏠 Главная</a>
                        <a href="/Trainer/Attendance">📝 Посещаемость</a>
                        <a href="/Trainer/Schedule">📅 Расписание</a>
                        <a href="/Trainer/Notes">📝 Заметки</a>
                    }
                    <a href="/Logout" class="logout">🚪 Выход</a>
                }
                else
                {
                    <a href="/">🏠 Главная</a>
                }
            </nav>
        </div>
    </header>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="notification success">
            ✅ @TempData["SuccessMessage"]
            <button class="notification-close" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="notification error">
            ⚠️ @TempData["ErrorMessage"]
            <button class="notification-close" onclick="this.parentElement.remove()">×</button>
        </div>
    }
    <main class="main-content">
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </main>

    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-section">
                <h3>PolesSU Sports</h3>
                <p>Система управления спортивными секциями Полесского государственного университета</p>
            </div>
            <div class="footer-section">
                <h3>Контакты</h3>
                <p>📍 г. Пинск, ул. Ленинская, 32</p>
                <p>📞 +375 (165) 35-00-00</p>
                <p>✉️ sport@polessu.by</p>
            </div>
            <div class="footer-section">
                <h3>Информация</h3>
                <p>© 2026 PolesSU Sports. Все права защищены.</p>
                <p>Кафедра физического воспитания и спорта</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>Полесский государственный университет | Кафедра физического воспитания и спорта</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>